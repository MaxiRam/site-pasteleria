# Secret usado para firmar (HMAC-SHA256) la cookie de sesión de admin.
# Obligatorio: sin esto la app falla al arrancar (fail-fast, ver
# src/lib/auth/session.ts). Generar uno propio, por ejemplo con:
#   openssl rand -hex 32
SESSION_SECRET=reemplazar-con-un-secret-random-largo

# Credenciales para scripts/seed-admin.ts (npm run db:seed). Solo se usan
# una vez para crear el único admin del negocio; no quedan en la app.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=reemplazar-con-una-password-segura

# Base de datos (libSQL/Turso). Local: archivo SQLite plano ("file:" +
# path). Opcional: si no se define, se usa el default de src/db/path.ts
# (file:./data/dev.db).
DATABASE_URL=file:./data/dev.db

# En producción (Turso): DATABASE_URL="libsql://<db>.turso.io" y este token
# es obligatorio. En local (DATABASE_URL="file:...") no hace falta, se deja
# vacío/sin definir.
# DATABASE_AUTH_TOKEN=
